{
  "Domain": {
    "Server": "",
    "SearchBase": "",
    "IncludeEmptyOus": true
  },
  "Attributes": {
    "PersonalIdAttribute": "employeeID",
    "DisplayNameAttribute": "displayName"
  },
  "Generator": {
    "DefaultLength": 12,
    "UseUpper": true,
    "UseLower": true,
    "UseDigit": true,
    "UseSpecial": false,
    "SpecialChars": "!@#$%&*",
    "AvoidAmbiguous": true,
    "SamePasswordForAll": false
  },
  "Report": {
    "OutputFolder": "files\\report",
    "OpenAfterRun": true,
    "CombinedReportByDefault": false
  },
  "Logging": {
    "Folder": "logs",
    "RetentionDays": 30
  },
  "Ui": {
    "DomainLabel": "",
    "TestModeDefault": true
  },
  "Demo": {
    "Enabled": false,
    "AutoFallbackWhenNoAd": true
  }
}
